# Copy to .env and adjust as needed.
APP_NAME="Gatekeeper AI / Flare Control System"
HOST=0.0.0.0
PORT=8000
# CORS is for local dev only — the production dashboard is bundled and served
# same-origin by this app, so it needs no cross-origin grant.
# Comma-separated list of allowed CORS origins (exact match).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
# Regex covering any localhost port (dev). Keep this scoped: allow_credentials
# is on, so a wildcard third-party host here is a standing credentialed grant.
ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# Operating mode: SIMULATION (default, in-process fake PLC) or LIVE (real hardware).
MODE=SIMULATION

# PLC / Modbus connection (used when MODE=LIVE).
PLC_HOST=127.0.0.1
PLC_PORT=502
PLC_UNIT_ID=1
PLC_KW_REGISTER=100

# Control-loop tuning.
BUFFER_FACTOR=0.90
HYSTERESIS=0.05
LOOP_INTERVAL=10
