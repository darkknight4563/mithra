# Copy to .env and adjust as needed.
APP_NAME="Gatekeeper AI / Flare Control System"
HOST=0.0.0.0
PORT=8000
# JSON array of allowed CORS origins. "*" is fine for local dev.
CORS_ORIGINS=["*"]

# Operating mode: SIMULATION (default, in-process fake PLC) or LIVE (real hardware).
MODE=SIMULATION

# PLC / Modbus connection (used when MODE=LIVE).
PLC_HOST=127.0.0.1
PLC_PORT=502
PLC_UNIT_ID=1
PLC_KW_REGISTER=100

# Control-loop tuning.
BUFFER_FACTOR=0.90
HYSTERESIS=0.05
LOOP_INTERVAL=10
