# Copy to .env and adjust as needed.
APP_NAME="Mithra — Flare Control System"
HOST=0.0.0.0
PORT=8000
# CORS is for local dev only — the production dashboard is bundled and served
# same-origin by this app, so it needs no cross-origin grant.
# Comma-separated list of allowed CORS origins (exact match).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
# Regex covering any localhost port (dev). Keep this scoped: allow_credentials
# is on, so a wildcard third-party host here is a standing credentialed grant.
ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# Operating mode: SIMULATION (default, in-process fake PLC) or LIVE (real hardware).
MODE=SIMULATION

# PLC / Modbus connection (used when MODE=LIVE).
PLC_HOST=127.0.0.1
PLC_PORT=502
PLC_UNIT_ID=1
PLC_KW_REGISTER=100

# Control-loop tuning.
BUFFER_FACTOR=0.90
HYSTERESIS=0.05
LOOP_INTERVAL=10

# Genset controller register map (LIVE). "generic" = single kW register above.
# Named presets add frequency + alarm word; override any field explicitly.
GENSET_MAP=generic
# PLC_HZ_REGISTER=1031
# PLC_HZ_SCALE=10
# PLC_ALARM_REGISTER=2048
# PLC_ALARM_MASK=65535
# PLC_KW_SCALE=1000
# PLC_KW_WORDS=2

# Frequency governor. Islanded gensets are protected by Hz, not kW.
NOMINAL_HZ=50.0          # 60.0 in the Americas
HZ_ADD_MARGIN=0.3        # no ADD below nominal - 0.3 Hz
HZ_SHED_MARGIN=1.0       # shed one miner per tick below nominal - 1.0 Hz
HZ_TRIP_MARGIN=2.5       # failsafe below nominal - 2.5 Hz

# Miner fleet: SIMULATED (in-process fake) or CGMINER (real ASICs over the
# CGMiner/BOSminer/LuxOS API, inventory from FLEET_CONFIG; see fleet.example.json).
FLEET_BACKEND=SIMULATED
FLEET_CONFIG=fleet.json
MINER_API_PORT=4028
MINER_API_TIMEOUT=3.0
FLEET_POLL_INTERVAL=5.0
